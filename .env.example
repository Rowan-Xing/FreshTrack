# PostgreSQL on a non-default port to avoid colliding with an existing local service.
POSTGRES_DB=freshtrack
POSTGRES_USER=freshtrack
POSTGRES_PASSWORD=freshtrack_local_only
POSTGRES_PORT=55435
DATABASE_URL=postgresql://freshtrack:freshtrack_local_only@127.0.0.1:55435/freshtrack?schema=public
TEST_DATABASE_URL=postgresql://freshtrack:freshtrack_local_only@127.0.0.1:55435/freshtrack?schema=freshtrack_test

API_HOST=0.0.0.0
API_PORT=3000
SESSION_TTL_DAYS=30
LOG_LEVEL=info

# Replace with the development computer's LAN IP before using a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
